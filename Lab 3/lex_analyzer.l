/* This file is divided into 3 main sections:
    1. Definition section   (%{  %})
    2. Rules section        (between %% %%)
    3. User code section    (after second %%) */

%option noyywrap            
        /* Flex calls a function yywrap() when it reaches end of input.
        // By using this option, you tell Flex:
        // “Don’t call yywrap(), just stop lexing at EOF.”
        // Reason: You don’t need to define yywrap() yourself.*/

/* Definition section starts here.*/
%{      

#include"symbol_info.h"         // Includes your symbol_info class.
                                // This class is used to store token information (like identifier name, type, array size, etc.).
                                
#define YYSTYPE symbol_info*    // YYSTYPE defines the data type of the semantic value of a token. YYSTYPE tells the parser what type of data a token carries.
                                // Here, you tell the parser: Each token will pass a pointer to symbol_info as its semantic value.

#include "y.tab.h"              // This is generated by Yacc/Bison.
                                // It contains all token definitions like INT, ID, ADDOP, etc.
                                // Needed so the lexer can return the correct token types to the parser.

extern YYSTYPE yylval;          // yylval is the variable used to pass semantic values from lexer to parser.

void yyerror(char *);           // yyerror() is a function used by the parser to report syntax errors.
                                // When the parser finds something that does not match the grammar rules, it calls this function.
                                //          void → function returns nothing
                                //          yyerror → name of the error handling function
                                //          char * → receives an error message string

extern int lines;               // Keeps track of current line number while scanning.

%}     // Definition section ends here.

/* This defines delimiter characters.space, tab, vertical tab, carriage return, form feed. */
delim	 [ \t\v\r\f]

/* newline, carriage return */                     
newline  \r?\n   

 /* This means one or more whitespace characters. */ 
ws		 {delim}+    

/* This defines a letter or underscore, which can be the first character of an identifier. */ 
letter_	 [A-Za-z_]

/* This defines a digit, which can be part of an identifier or a number. */    
digit	 [0-9]

/* This defines an identifier: starts with a letter or underscore, followed by zero or more letters, digits, or underscores. */ 
id		 {letter_}({letter_}|{digit})* 

/* Matches integer numbers. */ 
integers {digit}+

/* This matches floating-point numbers. */ 
floats	 {digit}*(\.{digit}+)|{digit}*(\.{digit}+)?((E|e)[-]?{digit}+)  
 
/* This section is the Rules part of your Flex lexer. Each rule has the form:  pattern    { action } */
/* Meaning: When the lexer finds a pattern, it executes the action. */ 
%%

{ws}		{ /* ignore whitespace */ }
{newline}	{ lines++; }

if          { return IF; }        { /* When the lexer reads the word if, it returns the token IF to the parser, identifying it as a keyword.*/ }
else		{ return ELSE; }
for         { return FOR; }
while       { return WHILE; }
do          { return DO; }
break       { return BREAK; }
continue    { return CONTINUE; }
return      { return RETURN; }
int         { return INT; }
float       { return FLOAT; }
char        { return CHAR; }
void        { return VOID; }
double      { return DOUBLE; }
switch      { return SWITCH; }
case        { return CASE; }
default     { return DEFAULT; }
printf      { return PRINTLN; }



"+"|"-"	    {
                symbol_info *s = new symbol_info((string)yytext,"ADDOP"); { /* When the lexer matches + or -, it creates a symbol_info object for the operator,*/ }
                s->set_line_no(lines);
                yylval = (YYSTYPE)s;                                      { /* stores it in yylval, and returns the token ADDOP to the parser. */ }
                return ADDOP;
		    }
"*"|"/"|"%"    {
                symbol_info *s = new symbol_info((string)yytext,"MULOP");
                s->set_line_no(lines);
                yylval = (YYSTYPE)s;
                return MULOP;
            }
"++"        { return INCOP; }
"--"        { return DECOP; }
"<"|">"|"<="|">="|"=="|"!=" {
                symbol_info *s = new symbol_info((string)yytext,"RELOP");
                s->set_line_no(lines);
                yylval = (YYSTYPE)s;
                return RELOP;
            }

"="         {
                symbol_info *s = new symbol_info((string)yytext,"ASSIGNOP");
                s->set_line_no(lines);
                yylval = (YYSTYPE)s;
                return ASSIGNOP;
            }
"&&"|"||"   {
		   	symbol_info *s = new symbol_info((string)yytext,"LOGICOP");
			s->set_line_no(lines);
			yylval = (YYSTYPE)s;
			return LOGICOP;
		    }

"!"        { return NOT; }
"("        { return LPAREN; }
")"        { return RPAREN; }
"{"        { return LCURL; }
"}"        { return RCURL; }
"["        { return LTHIRD; }
"]"        { return RTHIRD; }
";"        { return SEMICOLON; }
","        { return COMMA; }

{id}       {
                symbol_info *s = new symbol_info((string)yytext,"ID");
                s->set_line_no(lines);
                yylval = (YYSTYPE)s;
                return ID;
            }
{integers} {
                symbol_info *s = new symbol_info((string)yytext,"INT");
                s->set_line_no(lines);
                yylval = (YYSTYPE)s;
                return CONST_INT;
            }
{floats}   {
                symbol_info *s = new symbol_info((string)yytext,"FLOAT");
                s->set_line_no(lines);
                yylval = (YYSTYPE)s;
                return CONST_FLOAT;
            }

%%     // Rules section ends here. User code section starts here.
